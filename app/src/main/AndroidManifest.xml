<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for the one-time model download; inference itself is fully offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Listening. The recogniser runs on-device, so nothing leaves the phone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Listening for the name. Android has not let a background process hold
         the microphone since Oreo, so the only way to hear a wake word is a
         foreground service that says, in the shade, that it is listening. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- The model download reports progress through a notification, and on
         Android 13+ that is silently dropped without this permission — which is
         why "you can close the app, the download continues" could not be
         confirmed from the phone. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Updating in place from GitHub Releases. Android still asks the user to
         allow installs, and still refuses any APK not signed with the same key
         as the one already installed. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Placing calls and sending messages on request. Both are gated behind an
         on-screen confirmation naming the person and the number, and neither is
         ever reached without the user asking for it in so many words. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- The background update check is scheduled to survive a reboot, which
         Android only allows with this. A check that stops at the next restart
         is a check that stops. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Asking for CALL_PHONE and SEND_SMS otherwise declares that this app
         requires telephony hardware, which quietly excludes tablets and any
         device without a radio. Jarvis is still useful on one; it just cannot
         call from it. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Answering "where am I" and "what is on today". Both are read-only, both
         are asked for at the moment they are first needed rather than up front,
         and neither is used for anything but answering the question. Coarse
         location only: street-level accuracy is not needed to say which part of
         town you are in, and asking for less is the honest default. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Location hardware is not required. Jarvis is still useful without it. -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <!-- Setting a timer through the phone's own clock app. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- RECORD_AUDIO otherwise implies a microphone is required. Jarvis is still
         usable by typing on a device without one. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Android 11+ hides other packages unless asked for. Without this the
         speech recogniser and TTS engine are invisible to the app. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Opening apps by name. Android 11+ hides every other package unless
             asked for, so without this the launcher list comes back empty and
             "open YouTube" can never find anything. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".JarvisApplication"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jarvis">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Jarvis">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: only the package installer talks to it, and it is
             reached through a PendingIntent rather than by name. -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <!-- Holds the microphone and listens for one word. Not exported: it is
             started by the app and by nothing else. -->
        <service
            android:name=".voice.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Reads the shade so "what did I miss" has an answer. Exported and
             bound by the system, which is the only way Android allows this;
             the BIND permission is what stops anything else binding it. The
             user must switch it on in system settings by hand — there is no
             dialog for this one. Nothing read here is written to disk. -->
        <service
            android:name=".sense.NoticeListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Runs a few hundred bytes of update check, twice a day. -->
        <service
            android:name=".update.UpdateCheckJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>

</manifest>
