<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for the one-time model download; inference itself is fully offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Listening. The recogniser runs on-device, so nothing leaves the phone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- The model download reports progress through a notification, and on
         Android 13+ that is silently dropped without this permission — which is
         why "you can close the app, the download continues" could not be
         confirmed from the phone. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Updating in place from GitHub Releases. Android still asks the user to
         allow installs, and still refuses any APK not signed with the same key
         as the one already installed. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Placing calls and sending messages on request. Both are gated behind an
         on-screen confirmation naming the person and the number, and neither is
         ever reached without the user asking for it in so many words. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Asking for CALL_PHONE and SEND_SMS otherwise declares that this app
         requires telephony hardware, which quietly excludes tablets and any
         device without a radio. Jarvis is still useful on one; it just cannot
         call from it. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Setting a timer through the phone's own clock app. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- RECORD_AUDIO otherwise implies a microphone is required. Jarvis is still
         usable by typing on a device without one. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Android 11+ hides other packages unless asked for. Without this the
         speech recogniser and TTS engine are invisible to the app. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Opening apps by name. Android 11+ hides every other package unless
             asked for, so without this the launcher list comes back empty and
             "open YouTube" can never find anything. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".JarvisApplication"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jarvis">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Jarvis">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: only the package installer talks to it, and it is
             reached through a PendingIntent rather than by name. -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />
    </application>

</manifest>
